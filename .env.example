# Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=password
PG_DATABASE=bio_games

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=your_jwt_secret_change_in_production
ADMIN_JWT_SECRET=your_admin_jwt_secret_change_in_production

# HMAC Secret for Request Signing
HMAC_SECRET=your_hmac_secret_change_in_production

# Server Ports
AUTH_PORT=3001
MATCHMAKING_PORT=3002
GAME_LOGIC_PORT=3003
ECONOMY_PORT=3004
ANALYTICS_PORT=3005
ADMIN_PORT=3006

# Security
ENABLE_SECURITY_CHECKS=true
APK_SIGNATURE_SHA256=YOUR_EXPECTED_SHA256_SIGNATURE
APK_HASH=YOUR_EXPECTED_APK_SHA256_HASH

# AWS Configuration (for production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET=bio-games-assets

# Firebase (optional)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PROJECT_ID=your_project_id

# Monitoring
SENTRY_DSN=your_sentry_dsn
NEW_RELIC_LICENSE_KEY=your_new_relic_key

# Feature Flags
ENABLE_MULTIPLAYER=true
ENABLE_LOOTBOXES=true
ENABLE_ANALYTICS=true
