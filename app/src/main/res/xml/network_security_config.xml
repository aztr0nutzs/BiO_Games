<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- SSL Pinning for game servers (replace with actual domains and pins) -->
    <domain-config>
        <domain includeSubdomains="true">your-game-server.com</domain>
        <pin-set expiration="2026-12-31">
            <pin digest="SHA-256">YOUR_PUBLIC_KEY_PIN_1</pin>
            <pin digest="SHA-256">YOUR_PUBLIC_KEY_PIN_2</pin>
        </pin-set>
    </domain-config>

    <!-- Additional domains if needed -->
    <domain-config>
        <domain includeSubdomains="true">firebase.googleapis.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>